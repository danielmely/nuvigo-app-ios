    "Add one in the Addons tab, or connect Jellyfin or Plex in Account.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade uno en la pestaña Addons, o conecta Jellyfin o Plex en Cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez-en un dans l’onglet Addons, ou connectez Jellyfin ou Plex dans Compte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「アドオン」タブで追加するか、「アカウント」でJellyfinまたはPlexを接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“附加组件”标签页中添加，或在“账户”中连接 Jellyfin 或 Plex。"
          }
        }
      }
    },
